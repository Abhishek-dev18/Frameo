# Copy this file to .env and fill it in. Never commit .env.

# --- Cloudflare R2 (video hosting so Instagram can download the MP4) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pixelscript-videos
# The bucket's public URL, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=

# --- Instagram (Instagram API with Instagram Login) ---
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v23.0

# --- YouTube (Google Cloud OAuth client, type "Desktop app") ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# private | unlisted | public  (stays private until Google audits your API project)
YT_PRIVACY=private

# Optional: path to a Chrome/Chromium binary if Remotion can't download its own
REMOTION_BROWSER=

# --- AI script writer (Google AI Studio, free tier is fine to start) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram alerts (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
