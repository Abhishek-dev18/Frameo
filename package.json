{
  "name": "pixelscript",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/index.mjs\" \"vite --config web/vite.config.mjs\"",
    "start": "vite build --config web/vite.config.mjs && node server/index.mjs",
    "build:web": "vite build --config web/vite.config.mjs",
    "server": "node server/index.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "post": "node scripts/post.mjs",
    "scheduler": "node scripts/scheduler.mjs",
    "yt:auth": "node scripts/youtube-auth.mjs",
    "ig:check": "node scripts/ig-check.mjs",
    "ig:refresh": "node scripts/ig-refresh.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@remotion/cli": "4.0.290",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "googleapis": "144.0.0",
    "node-cron": "3.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/kalam": "^5.2.5",
    "@types/react": "18.3.12",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "typescript": "5.6.3",
    "vite": "^5.4.10"
  }
}
